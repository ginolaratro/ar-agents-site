# Your domain (used in sitemap.xml). Include https://, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Where "Book a demo" links. A Calendly, HubSpot, or Cal.com URL works here.
NEXT_PUBLIC_DEMO_URL=https://calendly.com/your-link

# Your app's address. "Sign in" only appears in the header and footer when this is set.
NEXT_PUBLIC_APP_URL=https://app.example.com
